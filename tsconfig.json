    "dist/library.mjs",
    "dist/art/classic.mjs",
    "dist/art/snacks.mjs",
    "dist/art/mains.mjs",
    "dist/art/drinks.mjs",
    "dist/art/sweets.mjs",
    "dist/templates.mjs",
    "dist/catalog.mjs",
    "dist/domain.mjs",
    "dist/qr.mjs"
  ]
}
